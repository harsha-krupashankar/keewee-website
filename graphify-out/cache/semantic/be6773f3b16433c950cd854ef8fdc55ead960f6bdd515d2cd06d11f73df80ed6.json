{"nodes": [{"id": "readme_keewee_website", "label": "keewee.in website (Next.js 16 + Sanity)", "file_type": "document", "source_file": "README.md", "source_location": "# keewee.in", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_first_time_setup", "label": "First-time setup (project ID, tokens, CORS, seed, webhook)", "file_type": "document", "source_file": "README.md", "source_location": "### First-time setup", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_content_model", "label": "Content model (singletons, collections, objects)", "file_type": "document", "source_file": "README.md", "source_location": "## Content model", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Singletons are pinned in sanity/structure.ts and their create/delete/duplicate actions stripped in sanity.config.ts so a second Home page cannot appear."}, {"id": "readme_rendering_and_caching", "label": "Rendering and caching (cacheComponents)", "file_type": "rationale", "source_file": "README.md", "source_location": "## Rendering and caching", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published visitors take a synchronous path and get a fully prerendered page; only draft-mode requests pay for the cookie read."}, {"id": "readme_on_demand_invalidation", "label": "On-demand invalidation (SanityLive + /api/revalidate)", "file_type": "rationale", "source_file": "README.md", "source_location": "## Rendering and caching", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cacheLife uses Sanity's one-year profile in next.config.ts because updates are already pushed by <SanityLive /> for open sessions and the /api/revalidate webhook for everyone else; time-based expiry is unnecessary."}, {"id": "readme_preview_visual_editing", "label": "Preview and visual editing (Presentation tool, draft mode)", "file_type": "document", "source_file": "README.md", "source_location": "## Preview and visual editing", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_seeding", "label": "Seeding (scripts/seed.ts, idempotent one-time migration)", "file_type": "rationale", "source_file": "README.md", "source_location": "## Seeding", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic _ids written with createOrReplace in one transaction make the seed idempotent, and therefore destructive once real editing has started; delete scripts/legacy and seed.ts after it has run everywhere. Post bodies and images cannot be recovered because they never existed."}, {"id": "readme_never_dot_in_id", "label": "Never put a dot in a document _id (fix-dotted-ids)", "file_type": "rationale", "source_file": "README.md", "source_location": "### Never put a dot in a document `_id`", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dot is a path separator; path-prefixed docs are excluded from unauthenticated reads even in a public dataset. scripts/fix-dotted-ids.ts recreates documents under clean IDs and rewrites every _ref in the same transaction."}, {"id": "readme_type_generation", "label": "Type generation (hand-written types.ts vs generated sanity.types.ts)", "file_type": "rationale", "source_file": "README.md", "source_location": "## Type generation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two type sources deliberately: hand-written types.ts keeps prop types readable and compiles without a generator; sanity.types.ts from typegen is the authority. Reconciliation is manual because Portable Text is nominal in @portabletext/react but structural in typegen, so a mechanical assertion would false-positive on every rich-text type."}, {"id": "readme_scripts", "label": "npm scripts (dev, build, typecheck, lint, seed, fix-ids, typegen)", "file_type": "document", "source_file": "README.md", "source_location": "## Scripts", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sanity_presentation_resolve", "label": "sanity/presentation/resolve.ts (document <-> URL)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_seed", "label": "scripts/seed.ts", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "scripts_fix_dotted_ids", "label": "scripts/fix-dotted-ids.ts", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sanity_lib_types", "label": "sanity/lib/types.ts (hand-written result types)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sanity_sanity_types", "label": "sanity/sanity.types.ts (generated by typegen)", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "next_config", "label": "next.config.ts", "file_type": "code", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_keewee_website", "target": "readme_first_time_setup", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_keewee_website", "target": "readme_content_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weig