{"nodes": [{"id": "docs_google_sheets_forms_forms_to_sheets", "label": "Form submissions to Google Sheets", "file_type": "document", "source_file": "docs/google-sheets-forms.md", "source_location": "# Form submissions \u2192 Google Sheets", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The five public forms POST to app/api/forms/route.ts which forwards server-side to a Google Apps Script Web App, so the webhook URL never ships to the browser."}, {"id": "docs_google_sheets_forms_google_apps_script_web_app", "label": "Google Apps Script Web App (Code.gs)", "file_type": "concept", "source_file": "docs/google-sheets-forms.md", "source_location": "## Code.gs", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Spreadsheet IDs are read from Script Properties (SUBSCRIBE_SHEET_ID, QUOTE_SHEET_ID, AUDIT_SHEET_ID) rather than source because the repo is public. Deployed as Web app, execute as Me, access Anyone; sheets shared as Restricted."}, {"id": "docs_google_sheets_forms_google_sheets_webhook_url", "label": "GOOGLE_SHEETS_WEBHOOK_URL env var", "file_type": "concept", "source_file": "docs/google-sheets-forms.md", "source_location": "line 17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No NEXT_PUBLIC_ prefix so the /exec URL stays server-side only."}, {"id": "docs_google_sheets_forms_form_types", "label": "Form types: subscribe / quote / audit", "file_type": "concept", "source_file": "docs/google-sheets-forms.md", "source_location": "form type table", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_google_sheets_forms_payload_shapes", "label": "Form payload shapes and source values", "file_type": "concept", "source_file": "docs/google-sheets-forms.md", "source_location": "## Payload shapes", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_google_sheets_forms_dopost", "label": "doPost (Apps Script entry point)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": "Code.gs doPost", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_google_sheets_forms_safe", "label": "safe (formula-injection guard)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": "Code.gs safe", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google Sheets treats cells starting with =, +, -, @ as formulas; a form field could plant a live formula that exfiltrates rows. A leading apostrophe forces literal text."}, {"id": "docs_google_sheets_forms_appendrow", "label": "appendRow (writes header row on first use)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": "Code.gs appendRow", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_google_sheets_forms_json", "label": "json (ContentService JSON response)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": "Code.gs json", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_google_sheets_forms_rate_limiting", "label": "Vercel Firewall rate limit on /api/forms (30 POSTs / 600s)", "file_type": "rationale", "source_file": "docs/google-sheets-forms.md", "source_location": "## Rate limiting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced at the edge so blocked requests leave no runtime log and return Vercel's error envelope. All five forms share one path and one per-IP counter; the original 5/600s limit was exhausted by retries and by visitors sharing a CGNAT/office NAT IP, which made legitimate submissions fail."}, {"id": "docs_google_sheets_forms_submissionthrottlederror", "label": "SubmissionThrottledError (403/429 mapping)", "file_type": "concept", "source_file": "docs/google-sheets-forms.md", "source_location": "## Rate limiting", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Forms say 'wait a few minutes' instead of 'something went wrong', because a generic error invites an immediate retry that spends more of the same rate-limit budget."}, {"id": "app_api_forms_route", "label": "app/api/forms/route.ts (form proxy route)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lib_submit_form", "label": "lib/submit-form.ts (client submit helper)", "file_type": "code", "source_file": "docs/google-sheets-forms.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_google_sheets_forms_forms_to_sheets", "target": "app_api_forms_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/google-sheets-forms.md", "source_location": "line 3", "weight": 1.0}, {"source": "docs_google_sheets_forms_forms_to_sheets", "target": "docs_google_sheets_forms_google_apps_script_web_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/google-sheets-forms.md", "source_location": null, "weight": 1.0}, {"source": "docs_google_sheets_forms_forms_to_sheets", "target": "docs_google_sheets_forms_form_types", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/google-sheets-forms.md", "source_location": "form type table", "weight": 1.0}, {"source": "docs_google_sheets_forms_forms_to_sheets", "target": "docs_google_sheets_forms_google_sheets_webhook_url", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/google-sheets-forms.md", "source_location": "line 17", "weight": 1.0}, {"source": "app_api_form