# Copy to .env.local and fill in. Never commit .env.local.

# --- Required -------------------------------------------------------------
# From sanity.io/manage → your project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Preview / visual editing --------------------------------------------
# Viewer token. Lets the server read drafts and lets the Presentation tool
# stream live updates. sanity.io/manage → API → Tokens → Add token (Viewer).
SANITY_API_READ_TOKEN=

# --- Publishing -----------------------------------------------------------
# Any string you choose. Paste the same value into the Sanity webhook
# (sanity.io/manage → API → Webhooks) pointing at POST /api/revalidate, so
# published edits rebuild the static pages.
SANITY_REVALIDATE_SECRET=

# --- Seeding only ---------------------------------------------------------
# Editor token, used once by `npm run seed`. Remove it afterwards — nothing at
# runtime needs write access.
SANITY_API_WRITE_TOKEN=

# --- Form submissions -----------------------------------------------------
# Google Apps Script Web App URL that appends form rows to the two Sheets
# (subscribes to one spreadsheet, custom quotes to the other). Deploy the
# script in docs/google-sheets-forms.md and paste its /exec URL here.
GOOGLE_SHEETS_WEBHOOK_URL=

# --- Optional -------------------------------------------------------------
# Pin a different Content Lake API version. Defaults to 2026-07-27.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-07-27
