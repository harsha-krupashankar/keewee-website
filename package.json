{
  "name": "keewee-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:dry": "tsx --env-file=.env.local scripts/seed.ts --dry",
    "update-nav": "tsx --env-file=.env.local scripts/local/update-nav.ts",
    "update-socials": "tsx --env-file=.env.local scripts/local/update-socials.ts",
    "update-socials:dry": "tsx --env-file=.env.local scripts/local/update-socials.ts --dry",
    "remove-final-cta-secondary": "tsx --env-file=.env.local scripts/local/remove-final-cta-secondary.ts",
    "remove-final-cta-secondary:dry": "tsx --env-file=.env.local scripts/local/remove-final-cta-secondary.ts --dry",
    "update-mailto-ctas": "tsx --env-file=.env.local scripts/local/update-mailto-ctas.ts",
    "update-mailto-ctas:dry": "tsx --env-file=.env.local scripts/local/update-mailto-ctas.ts --dry",
    "open-calendly-new-tab": "tsx --env-file=.env.local scripts/local/open-calendly-new-tab.ts",
    "open-calendly-new-tab:dry": "tsx --env-file=.env.local scripts/local/open-calendly-new-tab.ts --dry",
    "fix-ids": "tsx --env-file=.env.local scripts/fix-dotted-ids.ts",
    "fix-ids:dry": "tsx --env-file=.env.local scripts/fix-dotted-ids.ts --dry",
    "revert-seed": "tsx --env-file=.env.local scripts/local/revert-seed.ts",
    "revert-seed:dry": "tsx --env-file=.env.local scripts/local/revert-seed.ts --dry",
    "clean-links": "tsx --env-file=.env.local scripts/local/clean-links-placeholders.ts",
    "clean-links:dry": "tsx --env-file=.env.local scripts/local/clean-links-placeholders.ts --dry",
    "typegen": "sanity schema extract --path=./sanity/extract.json --enforce-required-fields && sanity typegen generate"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.2",
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^7.25.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.6.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.2",
    "next-sanity": "^13.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.6.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
